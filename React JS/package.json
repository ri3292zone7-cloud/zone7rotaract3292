{
  "name": "react-js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:store": "vite build --config vite.store.config.js && node scripts/encode-store.mjs",
    "build:merch": "vite build --config vite.merch.config.js",
    "build:vendor": "vite build --config vite.vendor.config.js && node scripts/encode-vendor.mjs",
    "build:vendor-mannka": "vite build --config vite.vendor-mannka.config.js && node scripts/encode-vendor-mannka.mjs",
    "build:vendor-lumos": "vite build --config vite.vendor-lumos.config.js && node scripts/encode-vendor-lumos.mjs",
    "build:vendor-shankharapur": "vite build --config vite.vendor-shankharapur.config.js && node scripts/encode-vendor-shankharapur.mjs",
    "build:vendors": "vite build --config vite.vendors.config.js && node scripts/encode-vendors.mjs",
    "deploy:merch": "npm run build:merch && node scripts/deploy-merch.mjs",
    "serve:store": "node scripts/serve-store.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.5.1",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.30.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
